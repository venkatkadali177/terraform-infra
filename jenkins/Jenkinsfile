
pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'aws-cli'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins

  containers:
    - name: aws-cli
      image: public.ecr.aws/aws-cli/aws-cli:latest
      command: ["sh", "-c", "cat"]
      tty: true
      volumeMounts:
        - name: ecr-docker-config
          mountPath: /kaniko/.docker
        - name: workspace-volume
          mountPath: /home/jenkins/agent

    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["/busybox/sh", "-c", "cat"]
      tty: true
      volumeMounts:
        - name: ecr-docker-config
          mountPath: /kaniko/.docker
        - name: workspace-volume
          mountPath: /home/jenkins/agent

  volumes:
    - name: ecr-docker-config
      emptyDir: {}
    - name: workspace-volume
      emptyDir: {}
'''
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'AWS_REGION', defaultValue: 'ap-south-1')
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '388439400978')
        string(name: 'REPO_NAME', defaultValue: 'sample-app')
    }

    environment {
        AWS_REGION = "${params.AWS_REGION}"
        AWS_ACCOUNT_ID = "${params.AWS_ACCOUNT_ID}"
        REPO_NAME = "${params.REPO_NAME}"

        // All GitOps updates must go to main.
        GITOPS_BRANCH = 'main'

        APP_SOURCE_PATH = 'sample-app-source'
        HELM_VALUES_FILE = 'helm-charts/sample-app/values.yaml'

        ECR_REGISTRY = "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
        ECR_REPO = "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com/${params.REPO_NAME}"
    }

    stages {

        stage('1. Checkout GitHub') {
            steps {
                container('jnlp') {
                    checkout scm

                    script {
                        env.GIT_COMMIT_SHORT = sh(
                            script: 'git rev-parse --short=8 HEAD',
                            returnStdout: true
                        ).trim()

                        env.IMAGE_TAG = "${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"

                        env.COMMIT_MESSAGE = sh(
                            script: 'git log -1 --pretty=%s',
                            returnStdout: true
                        ).trim()

                        env.SKIP_PIPELINE =
                            env.COMMIT_MESSAGE.contains('[skip ci]') ? 'true' : 'false'

                        echo "Source branch: ${env.BRANCH_NAME ?: 'normal-pipeline'}"
                        echo "GitOps destination: ${env.GITOPS_BRANCH}"
                        echo "Commit: ${env.GIT_COMMIT_SHORT}"
                        echo "Image tag: ${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('2. Validate Application') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                container('jnlp') {
                    sh '''
                        set -eu

                        echo "Checking application files..."

                        test -f sample-app-source/index.html
                        test -f sample-app-source/Dockerfile
                        test -f helm-charts/sample-app/values.yaml

                        echo "Application validation successful."
                    '''
                }
            }
        }

        stage('3. AWS ECR Authentication') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                container('aws-cli') {
                    sh '''
                        set -eu

                        echo "Checking AWS identity..."
                        aws sts get-caller-identity

                        echo "Checking ECR repository..."
                        aws ecr describe-repositories \
                          --region "$AWS_REGION" \
                          --repository-names "$REPO_NAME" >/dev/null

                        echo "Generating ECR authentication..."

                        set +x

                        ECR_PASSWORD=$(aws ecr get-login-password \
                          --region "$AWS_REGION")

                        AUTH=$(printf 'AWS:%s' "$ECR_PASSWORD" | base64 | tr -d '\\n')

                        printf '{"auths":{"%s":{"auth":"%s"}}}' \
                          "$ECR_REGISTRY" "$AUTH" \
                          > /kaniko/.docker/config.json

                        unset ECR_PASSWORD AUTH

                        echo "ECR authentication configured successfully."
                    '''
                }
            }
        }

        stage('4. Build and Push Image') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                container('kaniko') {
                    sh '''
                        set -eu

                        echo "Building Docker image..."
                        echo "Image: $ECR_REPO:$IMAGE_TAG"

                        /kaniko/executor \
                          --context "$WORKSPACE/$APP_SOURCE_PATH" \
                          --dockerfile "$WORKSPACE/$APP_SOURCE_PATH/Dockerfile" \
                          --destination "$ECR_REPO:$IMAGE_TAG" \
                          --cache=true

                        echo "Image pushed successfully."
                    '''
                }
            }
        }

        stage('5. Verify ECR Image') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                container('aws-cli') {
                    sh '''
                        set -eu

                        echo "Verifying image in ECR..."

                        aws ecr describe-images \
                          --region "$AWS_REGION" \
                          --repository-name "$REPO_NAME" \
                          --image-ids imageTag="$IMAGE_TAG"

                        echo "ECR image verification successful."
                    '''
                }
            }
        }

        stage('6. Prepare Deployment') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                echo """
                Deployment prepared.

                Application: ${params.REPO_NAME}
                Image: ${env.ECR_REPO}:${env.IMAGE_TAG}
                Source branch: ${env.BRANCH_NAME ?: 'normal-pipeline'}
                GitOps destination: ${env.GITOPS_BRANCH}

                Helm values will be updated after approval.
                """
            }
        }

        stage('7. Manual Deployment Approval') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        id: 'DeploymentApproval',
                        message: """Approve deployment?

Application: ${params.REPO_NAME}
Image: ${env.ECR_REPO}:${env.IMAGE_TAG}
Source branch: ${env.BRANCH_NAME ?: 'normal-pipeline'}
GitOps destination: ${env.GITOPS_BRANCH}

Approving will update Helm values on main.""",
                        ok: 'Approve Deployment'
                    )
                }
            }
        }

        stage('8. GitOps Commit and Push to main') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                container('jnlp') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'github-creds',
                            usernameVariable: 'GIT_USERNAME',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu

                            cat > "$WORKSPACE/git-askpass.sh" <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' "$GIT_USERNAME" ;;
  *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
  *) exit 1 ;;
esac
EOF

                            chmod 700 "$WORKSPACE/git-askpass.sh"

                            export GIT_ASKPASS="$WORKSPACE/git-askpass.sh"
                            export GIT_TERMINAL_PROMPT=0

                            trap 'rm -f "$WORKSPACE/git-askpass.sh"' EXIT

                            git config user.name "Jenkins CI"
                            git config user.email "jenkins@users.noreply.github.com"

                            echo "Fetching latest main branch..."

                            git fetch origin "$GITOPS_BRANCH"

                            # Work from the latest main branch.
                            git checkout -B gitops-main "origin/$GITOPS_BRANCH"

                            # Update the image repository and tag on main.
                            sed -i -E \
                              "s|^([[:space:]]*repository:).*|\\1 ${ECR_REPO}|; s|^([[:space:]]*tag:).*|\\1 \\"${IMAGE_TAG}\\"|" \
                              "$HELM_VALUES_FILE"

                            echo "Updated Helm values:"
                            grep -A3 '^image:' "$HELM_VALUES_FILE"

                            git add "$HELM_VALUES_FILE"

                            if git diff --cached --quiet; then
                                echo "No GitOps changes to commit."
                                exit 0
                            fi

                            git commit -m \
                              "chore(gitops): update sample-app image ${IMAGE_TAG} [skip ci]"

                            echo "Pushing GitOps update to main..."

                            git push origin "HEAD:refs/heads/$GITOPS_BRANCH"

                            echo "GitOps changes pushed successfully to main."
                        '''
                    }
                }
            }
        }

        stage('9. Argo CD Deployment Handoff') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }

            steps {
                echo """
                GitOps update pushed successfully.

                Application: ${params.REPO_NAME}
                Image: ${env.ECR_REPO}:${env.IMAGE_TAG}
                GitOps branch: ${env.GITOPS_BRANCH}

                Argo CD should detect the Helm values change
                and automatically synchronize the application.
                """
            }
        }
    }

    post {
        success {
            script {
                if (env.SKIP_PIPELINE == 'true') {
                    echo "GitOps commit detected. Pipeline stages skipped."
                } else {
                    echo "Pipeline completed successfully."
                    echo "Image: ${env.ECR_REPO}:${env.IMAGE_TAG}"
                }
            }
        }

        failure {
            echo "Pipeline failed. Check Console Output."
        }

        always {
            echo "Pipeline execution finished."
        }
    }
}
